# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Legacy JWT anon یا کلید جدید publishable (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# اختیاری: secret (sb_secret_...) — فقط بک‌اند، بدون پیشوند NEXT_PUBLIC_
# SUPABASE_SECRET_KEY=

# Phase 2+: Google AI (Gemini) — server-only recommended
# GEMINI_API_KEY=
