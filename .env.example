# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# JWT anon یا کلید publishable جدید
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# JWT service_role — فقط سرور (ادمین، بدون RLS). بدون NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=

# اختیاری: اجرای خودکار npm run db:provision (اعمال supabase/provision_all.sql)
# رمز دیتابیس از Settings → Database — نه anon و نه service_role
# SUPABASE_DB_PASSWORD=
# یا URI کامل:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres

# Phase 2+: Google AI (Gemini) — server-only recommended
# GEMINI_API_KEY=
