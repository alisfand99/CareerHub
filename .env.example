# پورت dev (پیشنهاد: ثابت نگه دار). هرگز دو بار `npm run dev` روی همین پوشه باز نکن —
# کش .next خراب می‌شود و UI بدون استایل (layout.css / main-app.js → 404) می‌شود.
# بعد از `npm run build` هرگز مستقیم `npm run dev` نزن؛ اول `npm run dev:clean` یا پاک کردن پوشه `.next`.
# PORT=3005

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# JWT anon یا کلید publishable جدید
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# JWT service_role — فقط سرور (ادمین، بدون RLS). بدون NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=

# اختیاری: اجرای خودکار npm run db:provision (اعمال supabase/provision_all.sql)
# رمز دیتابیس از Settings → Database — نه anon و نه service_role
# SUPABASE_DB_PASSWORD=
# پورت پیش‌فرض اسکریپت provision: 6543 (pooler؛ اتصال مستقیم 5432 اغلب IPv6-only و timeout می‌خورد)
# SUPABASE_DB_PORT=6543
# یا URI کامل:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:6543/postgres

# Phase 2+: Google AI (Gemini) — server-only (orchestrator /api/chat/orchestrate)
# GEMINI_API_KEY=
# Optional: pin one model id. If unset, the app tries current Flash/Pro models in order until one works.
# GEMINI_MODEL=
